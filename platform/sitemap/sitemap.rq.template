PREFIX  dct:  <http://purl.org/dc/terms/>

# A document is listed if a public read rule of this dataspace grants access to it or to one of its
# classes. The entrypoint fills both VALUES blocks with rows from public-rules.rq and $base with the
# dataspace's own origin, so a store shared between dataspaces yields only this dataspace's documents.

SELECT  ?loc (max(?date) AS ?lastmod)
WHERE
  {   { VALUES ?Type { $class_rules }
        GRAPH ?loc
          { ?loc  a  ?Type }
        FILTER strstarts(str(?loc), "$base")
      }
    UNION
      { VALUES ?loc { $document_rules }
        GRAPH ?loc
          { ?loc  a  ?any }
        FILTER strstarts(str(?loc), "$base")
      }
    OPTIONAL
      { GRAPH ?loc
          { ?loc  dct:created  ?created }
      }
    OPTIONAL
      { GRAPH ?loc
          { ?loc  dct:modified  ?modified }
      }
    BIND(coalesce(?modified, ?created) AS ?date)
  }
GROUP BY ?loc
