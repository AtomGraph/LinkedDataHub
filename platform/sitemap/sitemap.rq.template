PREFIX  dct:  <http://purl.org/dc/terms/>

# A document is listed if a public read rule of its own dataspace grants access to it or to one of its classes.
# The entrypoint fills both VALUES blocks with (base, class) and (base, document) rows from public-rules.rq.

SELECT  ?loc (max(?date) AS ?lastmod)
WHERE
  {   { VALUES ( ?base ?Type ) { $class_rules }
        GRAPH ?loc
          { ?loc  a  ?Type }
        FILTER strstarts(str(?loc), str(?base))
      }
    UNION
      { VALUES ( ?base ?loc ) { $document_rules }
        GRAPH ?loc
          { ?loc  a  ?any }
        FILTER strstarts(str(?loc), str(?base))
      }
    OPTIONAL
      { GRAPH ?loc
          { ?loc  dct:created  ?created }
      }
    OPTIONAL
      { GRAPH ?loc
          { ?loc  dct:modified  ?modified }
      }
    BIND(coalesce(?modified, ?created) AS ?date)
  }
GROUP BY ?loc
