COMPOSE_CONVERT_WINDOWS_PATHS=1
COMPOSE_PROJECT_NAME=linkeddatahub

PROTOCOL=https
HTTP_PORT=81
HTTPS_PORT=4443
HOST=localhost

# owner's WebID certificate properties
OWNER_MBOX=john@doe.com
OWNER_GIVEN_NAME=John
OWNER_FAMILY_NAME=Doe
OWNER_ORG_UNIT=My unit
OWNER_ORGANIZATION=My org
OWNER_LOCALITY=Copenhagen
OWNER_STATE_OR_PROVINCE=Denmark
OWNER_COUNTRY_NAME=DK

MAX_CONTENT_LENGTH=2097152
# the longest result, in bytes, the /sparql endpoint answers a query with; a longer one is refused with 502. Counted on the
# store's response to the platform, not on what the caller receives. 5242880 (5 MiB) when unset
# MAX_QUERY_RESPONSE_LENGTH=5242880

# the assistant is opt-in: its plan service (the web-algebra container) is a proprietary image, distributed without its
# source. Uncomment to run it and offer it in the UI
# COMPOSE_PROFILES=assistant
# the assistant's plan service image tag (ghcr.io/atomgraph/webalgebra-server-ldh); `local` for an image built from a REST-VKG checkout
# WEBALGEBRA_VERSION=latest
# the OpenAI model the assistant plans and writes queries with; gpt-4o when unset
# OPENAI_MODEL=gpt-4o

# serves each dataspace's /sitemap.xml and lets its robots.txt allow crawling. Off in the platform unless set, since its
# queries walk every public document of a dataspace: remove it if that is too slow on a large one
ENABLE_SITEMAP=true
