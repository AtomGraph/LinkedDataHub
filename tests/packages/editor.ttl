@prefix ldh:    <https://w3id.org/atomgraph/linkeddatahub#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dh:     <https://w3id.org/atomgraph/linkeddatahub/document-hierarchy#> .
@prefix dct:    <http://purl.org/dc/terms/> .

<> a dh:Container ;
    dct:title "Editors" ;
    dct:description "Packages that turn a dataspace into an editor for a kind of data, each one pairing an ontology with the stylesheet that renders it." ;
    rdf:_1 <#content> ;
    rdf:_2 <#select-children> .

<#content> a ldh:XHTML ;
    rdf:value """<div xmlns="http://www.w3.org/1999/xhtml">
    <p class="ldh-body-lg">Packages that turn a dataspace into an editor for a kind of data, each one pairing an ontology with the stylesheet that renders it.</p>
</div>"""^^rdf:XMLLiteral .

<#select-children> a ldh:Object ;
    rdf:value ldh:ChildrenView .
