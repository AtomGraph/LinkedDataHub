# A query that runs long without a large result or much memory: the store's quads joined with
# themselves five times and counted. COUNT streams, so the heap stays flat while the join runs for
# as long as the query timeout allows. Used to hold a /sparql request open, so a handful in flight
# together occupy request slots - what the concurrency cap is meant to bound.
SELECT (COUNT(*) AS ?n)
WHERE {
  GRAPH ?g1 { ?s1 ?p1 ?o1 }
  GRAPH ?g2 { ?s2 ?p2 ?o2 }
  GRAPH ?g3 { ?s3 ?p3 ?o3 }
  GRAPH ?g4 { ?s4 ?p4 ?o4 }
  GRAPH ?g5 { ?s5 ?p5 ?o5 }
}
