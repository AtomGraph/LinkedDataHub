# A query that grows the heap rather than just the clock: the same five-way self-join, but every row
# is materialised and sorted instead of counted. ORDER BY cannot stream, so the engine buffers the
# whole intermediate result. Against the load stack's small Fuseki heap this reaches OutOfMemoryError
# before the query timeout - which is the case the ExitOnOutOfMemoryError + restart guard covers.
SELECT ?o1 ?o2 ?o3 ?o4 ?o5
WHERE {
  GRAPH ?g1 { ?s1 ?p1 ?o1 }
  GRAPH ?g2 { ?s2 ?p2 ?o2 }
  GRAPH ?g3 { ?s3 ?p3 ?o3 }
  GRAPH ?g4 { ?s4 ?p4 ?o4 }
  GRAPH ?g5 { ?s5 ?p5 ?o5 }
}
ORDER BY ?o1 ?o2 ?o3 ?o4 ?o5
