PREFIX :        <#>
PREFIX fuseki:  <http://jena.apache.org/fuseki#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ja:      <http://jena.hpl.hp.com/2005/11/Assembler#>
PREFIX tdb2:    <http://jena.apache.org/2016/tdb#>
PREFIX text:    <http://jena.apache.org/text#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX dc:      <http://purl.org/dc/elements/1.1/>
PREFIX dct:     <http://purl.org/dc/terms/>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX sioc:    <http://rdfs.org/sioc/ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX schema1: <http://schema.org/>
PREFIX schema2: <https://schema.org/>

[] a fuseki:Server .

# One dataset per dataspace role, named after the dataspace's origin with the deployment host dropped and the role
# appended: https://northwind-traders.demo.localhost -> northwind-traders.demo.end-user, and its admin origin ->
# northwind-traders.demo.admin. The root dataspace's prefix is empty, hence plain end-user and admin. Each dataset
# is stored in its own folder under ./fuseki/<name>/DB2.

# Queries are cancelled after 60 s, the Varnish backends' first_byte_timeout, past which no proxied client is still
# waiting for the answer. The timeout sits on the query endpoint: Fuseki honours ja:context there and on the
# dataset, but silently ignores it on the fuseki:Service.

<#end-user> a fuseki:Service ;
    fuseki:name "end-user" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; ja:context [ ja:cxtName "arq:queryTimeout" ; ja:cxtValue "60000" ] ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ] ;
    fuseki:dataset <#end-user-dataset> .

# The end-user dataset carries a Lucene index over the labels the search box reads, so a search is a prefix lookup
# rather than a regex over every label (30 s on 15M quads, hit or miss; 0.1-0.4 s with the index). One field, no
# text:graphField: a text:query inside an unbound GRAPH runs once per named graph, one per document, and never
# finishes. The parts are named, as jena-text's assemblers need (a blank node stops Fuseki from starting), and
# `make reindex` describes the dataset and its parts for jena.textindexer after a bulk load.
<#end-user-dataset> a text:TextDataset ;
    text:dataset <#end-user-tdb> ;
    text:index <#end-user-index> .

<#end-user-tdb> a tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/end-user/DB2" .

<#end-user-index> a text:TextIndexLucene ;
    text:directory <file:/fuseki/databases/end-user/lucene> ;
    text:storeValues false ;
    text:entityMap <#end-user-entity-map> .

<#end-user-entity-map> a text:EntityMap ;
    text:defaultField "label" ;
    text:entityField "uri" ;
    text:map (
        [ text:field "label" ; text:predicate rdfs:label ]
        [ text:field "label" ; text:predicate sh:name ]
        [ text:field "label" ; text:predicate dc:title ]
        [ text:field "label" ; text:predicate dct:title ]
        [ text:field "label" ; text:predicate foaf:name ]
        [ text:field "label" ; text:predicate foaf:givenName ]
        [ text:field "label" ; text:predicate foaf:familyName ]
        [ text:field "label" ; text:predicate sioc:name ]
        [ text:field "label" ; text:predicate skos:prefLabel ]
        [ text:field "label" ; text:predicate schema1:name ]
        [ text:field "label" ; text:predicate schema2:name ]
    ) .

<#admin> a fuseki:Service ;
    fuseki:name "admin" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; ja:context [ ja:cxtName "arq:queryTimeout" ; ja:cxtValue "60000" ] ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ] ;
    fuseki:dataset <#admin-dataset> .

<#admin-dataset> a tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/admin/DB2" .

# The HTTP tests' second instance (tests/http/config/remote/system.trig): origin remote.localhost, so remote.end-user
# and remote.admin by the naming rule above

<#remote.end-user> a fuseki:Service ;
    fuseki:name "remote.end-user" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; ja:context [ ja:cxtName "arq:queryTimeout" ; ja:cxtValue "60000" ] ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ] ;
    fuseki:dataset <#remote.end-user-dataset> .

<#remote.end-user-dataset> a tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/remote.end-user/DB2" .

<#remote.admin> a fuseki:Service ;
    fuseki:name "remote.admin" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; ja:context [ ja:cxtName "arq:queryTimeout" ; ja:cxtValue "60000" ] ] ;
    fuseki:endpoint [ fuseki:operation fuseki:update ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-rw ] ;
    fuseki:dataset <#remote.admin-dataset> .

<#remote.admin-dataset> a tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/remote.admin/DB2" .
