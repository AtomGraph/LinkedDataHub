# The sitemap and robots.txt of a dataspace, generated at startup and named after its host. %{HTTP_HOST} resolves
# to Request.getServerName(), the host without the port, which is how the entrypoint names the files. An internal
# rewrite, so the request URI stays at the origin's root - the location of a sitemap determines which URLs it may
# contain, and one served from a subdirectory could only cover that subdirectory.

RewriteRule ^/sitemap\.xml$ /static/sitemaps/%{HTTP_HOST}.xml
RewriteRule ^/robots\.txt$ /static/sitemaps/%{HTTP_HOST}.txt
