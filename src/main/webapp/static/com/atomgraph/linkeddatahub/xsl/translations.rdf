        <rdfs:label xml:lang="en-US">Your LinkedDataHub is ready!</rdfs:label>
        <rdfs:label xml:lang="es-ES">¡Su LinkedDataHub está listo!</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:nodeID="first-time-subtitle">
        <rdfs:label xml:lang="en-US">Unlock the value of your Knowledge Graph with data-driven content and low code apps.</rdfs:label>
        <rdfs:label xml:lang="es-ES">Libere el valor de su grafo de conocimiento con contenido basado en datos y aplicaciones low-code.</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:nodeID="first-time-body">
        <rdfs:label xml:lang="en-US">Create structured content backed by live data, intuitively explore graph datasets, model and manage RDF data, control data quality and more.</rdfs:label>
        <rdfs:label xml:lang="es-ES">Cree contenido estructurado respaldado por datos en vivo, explore conjuntos de datos de grafos de forma intuitiva, modele y gestione datos RDF, controle la calidad de los datos y más.</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:nodeID="first-time-body-emphasis">
